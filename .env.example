# App URLs
CLIENT_URL=http://localhost:3000
# Canonical public origin for sitemap / robots / llms.txt / JSON-LD
# SITE_URL=https://filterhero.net
# Client-side OG/canonical (set at build time)
# VITE_SITE_URL=https://filterhero.net
PORT=3001
NODE_ENV=development

# Stripe (server)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe (client — publishable key; never put sk_ in VITE_ vars)
STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Contact / lead gen
CONTACT_TO=info@filterhero.net
RESEND_API_KEY=
RESEND_FROM=Filter Hero <onboarding@resend.dev>
